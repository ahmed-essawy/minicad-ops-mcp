{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "minicad-ops-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat"],

	"durable_objects": {
		"bindings": [
			{ "name": "MCP_OBJECT", "class_name": "MiniCadOpsMCP" }
		]
	},

	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MiniCadOpsMCP"] }
	],

	"vars": {
		"WP_BASE_URL": "https://minicad.io"
	}
}
